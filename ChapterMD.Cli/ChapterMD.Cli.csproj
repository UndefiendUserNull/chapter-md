<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChapterMD.Core\ChapterMD.Core.csproj" />
  </ItemGroup>

	<Target Name="CopyToCli" AfterTargets="Build">
		<ItemGroup>
			<FilesToCopy Include="${OutputFolder}**\*.*"></FilesToCopy>
		</ItemGroup>
		<Copy SourceFiles="@(CopyToCli)" DestinationFolder="$(SolutionDir)build\$(Configuration)\%(RescrusiveDir)"></Copy>
	</Target>
	
</Project>
